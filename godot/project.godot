; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="tictactoe"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"

[debug]

; Static-typing guardrails for the thin GDScript view: treat the type-safety
; warnings as errors so a mistyped call fails `make gd-check` (godot
; --check-only) instead of at runtime. See docs/HACKING.md.
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=1
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=720
window/size/viewport_height=720

[input]

; Abstract input intents (docs/features/input-actions.md). Every action carries
; keyboard + gamepad events (device -1 = all devices) so mouse/touch, keyboard,
; and gamepad all reach the same `TicTacToe` core call. main.gd consumes these in
; _input so they take precedence over Godot's built-in ui_* focus navigation.
